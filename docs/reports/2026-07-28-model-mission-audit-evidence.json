  "issues": [
    {
      "priority": "High",
      "severity_order": 3,
      "finding": "Neural builder saves untrained models",
      "affected_tasks": 1,
      "confidence": "High",
      "evidence": "Both Keras and PyTorch scripts comment out data loading, fitting, and evaluation, then save weights.",
      "risk": "Students may mistake an architecture artifact for a trained model.",
      "recommendation": "Connect dataset, split, preprocessing, training, evaluation, and export to the layer builder."
    },
    {
      "priority": "High",
      "severity_order": 3,
      "finding": "YOLO learning-rate control is ignored",
      "affected_tasks": 2,
      "confidence": "High",
      "evidence": "Ultralytics logged optimizer=auto and explicitly ignored lr0=0.001 for detection and segmentation.",
      "risk": "The UI suggests a configuration changed when the framework discards it.",
      "recommendation": "Expose optimizer choice or set a concrete optimizer whenever learning rate is configurable."
    },
    {
      "priority": "High",
      "severity_order": 3,
      "finding": "YOLO validation uses inference confidence",
      "affected_tasks": 2,
      "confidence": "High",
      "evidence": "The explicit val call passes conf=0.25, producing lower mAP than training-time validation.",
      "risk": "Reported metrics are not comparable to standard YOLO validation defaults.",
      "recommendation": "Separate inference confidence from validation confidence; default validation to the framework metric threshold."
    },
    {
      "priority": "High",
      "severity_order": 3,
      "finding": "Final-test semantics are inconsistent",
      "affected_tasks": 5,
      "confidence": "High",
      "evidence": "Classical and sensor flows use test sets; image uses validation only; YOLO relies on YAML validation.",
      "risk": "Students can compare numbers that have different evidentiary meaning.",
      "recommendation": "Use one split contract with task-specific group/time/test options and label every metric by split."
    },
    {
      "priority": "Medium",
      "severity_order": 2,
      "finding": "Advanced is identical to Customize",
      "affected_tasks": 7,
      "confidence": "High",
      "evidence": "Captured control trees are exactly equal for Customize and Advanced in all seven tasks.",
      "risk": "Progressive disclosure promises depth that is not currently delivered.",
      "recommendation": "Merge the levels until Advanced adds genuinely advanced controls and explanations."
    },
    {
      "priority": "Medium",
      "severity_order": 2,
      "finding": "Dependency constraints are dropped",
      "affected_tasks": 6,
      "confidence": "High",
      "evidence": "Recipes declare version ranges, while displayed pip commands contain package names only.",
      "risk": "Future installs can generate incompatibilities that the tested recipes did not cover.",
      "recommendation": "Render pinned compatible ranges and include requirements.txt in downloads."
    },
    {
      "priority": "Medium",
      "severity_order": 2,
      "finding": "Classical output filenames collide",
      "affected_tasks": 2,
      "confidence": "High",
      "evidence": "Classification and regression both save trained_pipeline.joblib in the current directory.",
      "risk": "One project run can overwrite another without warning.",
      "recommendation": "Expose output directory and run name, and generate task-specific artifact names."
    },
    {
      "priority": "Medium",
      "severity_order": 2,
      "finding": "SMOTE follows dense one-hot encoding",
      "affected_tasks": 1,
      "confidence": "Medium",
      "evidence": "The tested classification pipeline encodes categories densely before ordinary SMOTE.",
      "risk": "Synthetic fractional one-hot categories can be hard to interpret and memory use scales poorly.",
      "recommendation": "Offer class weights first, SMOTENC for mixed data, and sparse-safe alternatives with guidance."
    },
    {
      "priority": "Medium",
      "severity_order": 2,
      "finding": "Sensor splitting lacks subject/time safeguards",
      "affected_tasks": 1,
      "confidence": "High",
      "evidence": "The generated sensor workflow randomly splits windows without group identifiers or timestamp ordering controls.",
      "risk": "Related windows can cross partitions and inflate evaluation on real sensor projects.",
      "recommendation": "Add group-aware, chronological, gap-aware, and label-window policy controls."
    },
    {
      "priority": "Medium",
      "severity_order": 2,
      "finding": "Download is not a full project",
      "affected_tasks": 7,
      "confidence": "High",
      "evidence": "The interface downloads one .py file and shows a pip command.",
      "risk": "Beginners still assemble environment, folders, configuration, and run documentation manually.",
      "recommendation": "Download a zip with script, config, requirements, README, data schema, and smoke test."
    },
    {
      "priority": "Low",
      "severity_order": 1,
      "finding": "Workflow rail relies on hidden horizontal scrolling",
      "affected_tasks": 7,
      "confidence": "High",
      "evidence": "At 360\u2013768 px the selected step is centered and neighboring steps are off-screen, though page overflow remains zero.",
      "risk": "Students may not realize earlier or later steps can be swiped.",
      "recommendation": "Add edge fades, arrows, or a compact step counter on narrow screens."
    }
